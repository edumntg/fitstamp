{
  "manifest_version": 3,
  "name": "FitStamp — LinkedIn job match",
  "short_name": "FitStamp",
  "version": "0.1.1",
  "description": "Stamps every LinkedIn job with how well it matches your resume, scored by Jev through OpenRouter or TypeSafe.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["src/content/jobs.js"],
      "css": ["src/content/jobs.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["src/content/profile.js"],
      "run_at": "document_idle"
    }
  ]
}
